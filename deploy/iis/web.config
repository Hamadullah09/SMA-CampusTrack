<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for campus.sma-techno.net.

  One application serves the whole product: the .NET API handles /api/v1/* and /hubs/*, and
  every other path falls through to the React app in wwwroot. That keeps the browser on a
  single origin, which means no CORS preflight, no second certificate, and no rebuild when
  the domain changes, because the SPA asks for the relative path /api/v1 and always reaches
  its own backend.

  The deploy workflow copies this over the web.config that `dotnet publish` generates.
-->
<configuration>
  <!--
    The location wrapper stops these settings being inherited by any child application, and
    on shared hosting it stops a web.config higher up the folder tree from colliding with
    the handler registration below.
  -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!--
        hostingModel must match every other application in the IIS pool.

        This site shares pool `smatechnologies-0nwo` with `fuelstore`. IIS refuses to run
        two applications in one pool under different hosting models and answers HTTP 500.34,
        which names neither application. Moving into this pool while declaring "inprocess"
        still failed, so the neighbour is out of process, and matching it is what lets both
        run.

        In process would be the better model on its own terms, running inside the IIS worker
        with no proxy hop. It is not available while the pool is shared. Out of process runs
        Kestrel behind an IIS reverse proxy: one local hop per request, and it still carries
        the WebSockets the live movement feed uses.

        The pool already has this model loaded from the neighbour, so this change should
        take effect without a recycle. Changing it in the other direction would not.

        If the site is ever given a pool of its own, switch back to "inprocess" and recycle
        the pool once.

        The publish is RID specific, so it produces an apphost and IIS launches the
        executable directly rather than relying on `dotnet` being on PATH at the right
        version.

        stdoutLogEnabled is off by design: on shared hosting that log grows unbounded and
        nothing rotates it. Switch it on temporarily if the site will not start, because a
        startup failure is the one thing no other log will show you, then switch it back.
      -->
      <aspNetCore processPath=".\CampusTrack.Api.exe"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>

      <!--
        IIS will not serve a file type it does not recognise, so an unregistered .apk comes
        back as a 404 rather than an app. The API streams the binary itself, but this also
        covers a build dropped into wwwroot as a plain static file.
      -->
      <staticContent>
        <remove fileExtension=".apk" />
        <mimeMap fileExtension=".apk" mimeType="application/vnd.android.package-archive" />
        <remove fileExtension=".webmanifest" />
        <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
        <remove fileExtension=".woff2" />
        <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      </staticContent>

      <httpProtocol>
        <customHeaders>
          <!-- The portal is not intended to be framed by another site. -->
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>

      <httpCompression>
        <dynamicTypes>
          <add mimeType="application/json" enabled="true" />
          <add mimeType="application/json; charset=utf-8" enabled="true" />
        </dynamicTypes>
      </httpCompression>

      <security>
        <requestFiltering>
          <!-- Publishing a build uploads an .apk; the IIS default cap is 30 MB. -->
          <requestLimits maxAllowedContentLength="209715200" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
