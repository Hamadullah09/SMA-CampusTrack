{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "campustrack-api",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "backend/src/CampusTrack.Api", "--urls", "http://localhost:5080"],
      "port": 5080,
      "autoPort": false
