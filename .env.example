# Copy to .env and set real values. Never commit .env.

# ---- database ---------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=campustrack
MYSQL_USER=campustrack
MYSQL_PASSWORD=change-me-app-password

# ---- security ---------------------------------------------------------------
# Must be at least 32 characters. Generate with:  openssl rand -base64 48
JWT_KEY=change-me-to-a-long-random-secret-at-least-32-characters
JWT_ISSUER=CampusTrack
JWT_AUDIENCE=CampusTrackClients

# First administrator, created on an empty database only.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=change-me-strong-password

# ---- school -----------------------------------------------------------------
SCHOOL_NAME=Your School
SCHOOL_CODE=YS
# Bell times and "today" are interpreted in this zone.
SCHOOL_TIMEZONE=UTC

# ---- deployment -------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
HTTP_PORT=80
PUBLIC_URL=https://school.example.com
# Leave false in production and run migrations as a deliberate step.
AUTO_MIGRATE=false

# ---- RFID -------------------------------------------------------------------
# Optional shared key for bringing up a new site before per-device keys are issued.
# Leave empty in steady state; every reader should have its own key.
RFID_BOOTSTRAP_KEY=

# ---- notifications (optional) -----------------------------------------------
# Without these the product still works: notifications are stored and shown in-app.
FIREBASE_PROJECT_ID=
FIREBASE_KEY_PATH=/app/secrets/firebase-service-account.json

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
