# Secrets — never commit
.env
deploy/secrets/
**/appsettings.Production.json
**/appsettings.Local.json
*.pfx
*-service-account.json

# .NET
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
ios/
*.iml

# Regenerated by the Flutter tool on every build; committing it guarantees conflicts.
**/android/**/GeneratedPluginRegistrant.java

# Android: the platform folder IS tracked -- it carries the application id, permissions and
# signing configuration, and regenerating it would silently reset all three. Only the
# machine-specific and secret parts are ignored.
**/android/local.properties
**/android/.gradle/
**/android/app/google-services.json

# Signing material. The keystore and its passwords must never be committed: together they
# are enough to publish an update that Android installs over the real app.
**/android/key.properties
*.jks
*.keystore
keys/
# Base64 of a keystore is still the keystore.
keystore-base64*.txt

# Runtime artefacts
logs/
storage/
*.log
*.db
*.db-shm
*.db-wal

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Local scratch
PROMPT.docx
