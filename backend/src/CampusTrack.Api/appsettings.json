{
  "ConnectionStrings": {
    "//": "Supply through the environment in production: ConnectionStrings__Default",
    "Default": ""
  },
  "Database": {
    "AutoMigrate": false,
    "AutoSeed": true
  },
  "Jwt": {
    "//": "Set Jwt__Key from a secret store. The API refuses to start outside development if this is left as the placeholder.",
    "Key": "REPLACE-WITH-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARACTERS",
    "Issuer": "CampusTrack",
    "Audience": "CampusTrackClients",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },
  "SchoolTime": {
    "TimeZoneId": "UTC"
  },
  "School": {
    "Name": "CampusTrack",
    "Code": "CT"
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminEmail": "admin@campustrack.local",
    "AdminPassword": ""
  },
  "RfidDevices": {
    "RequireDeviceAuthentication": true,
    "BootstrapApiKey": ""
  },
  "Firebase": {
    "ProjectId": "",
    "ServiceAccountKeyPath": "",
    "ServiceAccountJson": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "UserName": "",
    "Password": "",
    "FromAddress": "no-reply@campustrack.local",
    "FromName": "CampusTrack"
  },
  "FileStorage": {
    "RootPath": "storage",
    "MaxFileSizeBytes": 26214400
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/campustrack-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
