{
  "ConnectionStrings": {
    "Default": "server=127.0.0.1;port=3307;database=campustrack;user=campustrack;password=CampusTrack_Dev_2026;AllowUserVariables=true;UseAffectedRows=false"
  },
  "Database": {
    "AutoMigrate": true,
    "AutoSeed": true
  },
  "Jwt": {
    "Key": "development-only-signing-key-do-not-use-anywhere-else-2026",
    "Issuer": "CampusTrack",
    "Audience": "CampusTrackClients",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 30
  },
  "SchoolTime": {
    "TimeZoneId": "UTC"
  },
  "School": {
    "Name": "SMA Demonstration School",
    "Code": "CTS"
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminEmail": "admin@campustrack.local",
    "AdminPassword": "Admin@2026"
  },
  "RfidDevices": {
    "RequireDeviceAuthentication": true,
    "BootstrapApiKey": "dev-bootstrap-reader-key-2026"
  },
  "FileStorage": {
    "RootPath": "storage"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:4173", "http://localhost:3000" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/campustrack-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
